# Isusu web — copy to .env.local and fill in.
# Circle contract deployed on BNB Chain (chainId 56).
NEXT_PUBLIC_ISUSU_ADDRESS=0x0000000000000000000000000000000000000000
# Tether USDT on BNB Chain (18 decimals).
NEXT_PUBLIC_USDT_ADDRESS=0x55d398326f99059ff775485246999027b3197955
# Agent ID contract used for the create/join gate.
NEXT_PUBLIC_AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
# RPC for chain 56. Use http://127.0.0.1:8545 for the local anvil fork.
NEXT_PUBLIC_RPC_URL=https://bsc-dataseed.binance.org
# Optional: Logo.dev publishable token for the USDT mark. Falls back to a local SVG.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
